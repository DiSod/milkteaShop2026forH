# 复制为 .env 后按本机情况修改；.env 不提交（见 .gitignore）
# 连接信息只放这里，禁止写进页面代码或模板
SECRET_KEY=change-me-to-a-random-string
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=milktea_shop
# 仅 Windows 认证时保持 yes；若改用 SQL 登录则设 no 并填 SQL_USER/SQL_PASSWORD
SQL_TRUSTED=yes
# SQL_USER=
# SQL_PASSWORD=
SESSION_MINUTES=30
