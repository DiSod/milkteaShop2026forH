# ---- 数据（不进仓库，见 project/data/README.md 下载说明）----
project/data/raw/*
project/data/interim/*
project/data/generated/*
!project/data/**/README.md
!project/data/**/.gitkeep

# ---- SQL Server 产物 ----
*.mdf
*.ldf
*.bak
*.trn

# ---- 原始会话日志 ----
harness/logs/raw/

# ---- 系统与编辑器 ----
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp

# ---- 临时文件 ----
*.tmp
~$*

# ---- 根目录的临时工作文件（不提交）----
/_*.txt
/_*.ps1
/_*.sql

# ---- 提交包 / 压缩件（⚠️ 派生件：内容与源目录重复，不入库）----
# 例：weeks/submissions/第一阶段v0.1 胡博锐 何争霖.zip
# 源目录 weeks/submissions/v0.1/ 已在库中，zip 只是它的打包副本。
*.zip
*.7z
*.rar
